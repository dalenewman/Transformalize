<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <RootNamespace>Transformalize.Providers.Sqlite</RootNamespace>
    <AssemblyName>Transformalize.Provider.Sqlite</AssemblyName>
    <Version>1.4.3</Version>
    <FileVersion>1.4.3</FileVersion>
    <AssemblyVersion>1.4.3</AssemblyVersion>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.5" />
    <!--
      SECURITY PIN (2026-06-22): force the patched native SQLite bundle.
      Microsoft.Data.Sqlite 10.0.5 pulls SQLitePCLRaw.bundle_e_sqlite3 2.1.11 transitively,
      whose native lib (SQLitePCLRaw.lib.e_sqlite3 2.1.11) is vulnerable to CVE-2025-6965
      (NU1903, high severity; SQLite < 3.50.2 memory corruption). The 2.1.x native lib is
      deprecated with no fixed release, so the fix only exists in the 3.0.x bundle, which
      uses SourceGear.sqlite3 >= 3.50.4.5. Even the latest Microsoft.Data.Sqlite (10.0.9)
      still floors the bundle at 2.1.11, so an explicit pin is the only mitigation.
      Revisit: drop this when Microsoft.Data.Sqlite references a non-vulnerable bundle itself.
    -->
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" Version="3.0.3" />
    <ProjectReference Include="..\..\Ado\Transformalize.Provider.Ado\Transformalize.Provider.Ado.csproj" />
  </ItemGroup>
</Project>
